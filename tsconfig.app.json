{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "types/**/*",
    "src/**/*"
  ],
  "exclude": [
    "./src/api/protobuf/compiled.js"
  ],
  "compilerOptions": {
    "alwaysStrict": true,
    "baseUrl": ".",
    "checkJs": true,
    "incremental": true,
    "lib": [
      "DOM.AsyncIterable",
      "DOM.Iterable",
      "DOM",
      "ESNext.AsyncIterable",
      "ESNext",
      "WebWorker"
    ],
    "noUnusedLocals": true,
    "paths": {
      "@/*": ["src/*"]
    },
    "strictNullChecks": true,
    "target": "ESNext",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "types": ["element-plus/global", "vite-plugin-pwa/client", "vite-plugin-pwa/vue"],
    "verbatimModuleSyntax": true
  }
}
