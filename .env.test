## ================== 测试专用配置 ==================
## vitest 默认以 test 模式启动，会自动加载本文件（优先级低于 .env.test.local）
##
## 注意：vitest 不具备 vite dev server 的反代理能力，
## 因此这里必须给出【绝对地址】，不能复用开发环境的 /api-dev 前缀，
## 否则请求会被解析到 jsdom 的默认 origin 上而失败。
## --------------------------------------------------

## ================== 接口地址与 WebSocket ==================
# 接口地址（绝对地址，勿使用反代理前缀）
VITE_API_BASE = 'https://genshin-dev.momincong.com'

# WebSocket 地址
VITE_WS_BASE = 'wss://genshin-dev.momincong.com/ws'

## ==================== 接口测试账号 ====================
# 用于接口集成测试的普通用户账号（占位，真实凭据放在 .env.test.local）
VITE_TEST_USERNAME = ''
VITE_TEST_PASSWORD = ''

## ==================== 密钥相关配置 ====================
# API 前置账号（占位，真实凭据放在 .env.test.local）
VITE_API_AUTH_USERNAME = ''
# API 前置口令（占位，真实凭据放在 .env.test.local）
VITE_API_AUTH_PASSWORD = ''
